{
  "envs": {
    "local": { "baseURL": "http://127.0.0.1:9399" }
  },
  "defaultEnv": "local",
  "cases": [
    { "id": "TL01", "name": "登录成功发放token", "env": "local",
      "request": { "method": "POST", "path": "/api/auth/login", "body": { "readerId": 1001, "secret": "pass123" } },
      "expect": { "http": 200, "code": 200, "json": { "data.token": "contains:tk-", "data.nickname": "=测试读者" } } },
    { "id": "TL02", "name": "错密码应拒", "env": "local",
      "request": { "method": "POST", "path": "/api/auth/login", "body": { "readerId": 1001, "secret": "wrong" } },
      "expect": { "http": 200, "code": 500, "msgContains": "读者号或密码错误" } },
    { "id": "TL03", "name": "缺secret应拒", "env": "local",
      "request": { "method": "POST", "path": "/api/auth/login", "body": { "readerId": 1001 } },
      "expect": { "http": 200, "code": 500, "msgContains": "读者号或密码错误" } },
    { "id": "TL04", "name": "分页正常档pageNum1pageSize10", "env": "local",
      "request": { "method": "GET", "path": "/api/books", "query": { "pageNum": 1, "pageSize": 10 } },
      "expect": { "http": 200, "code": 200, "json": { "data.total": "=47", "data.rows[0].bookId": "=1" } } },
    { "id": "TL05", "name": "分页缺省档(本项目默认pageSize=20)", "env": "local",
      "request": { "method": "GET", "path": "/api/books" },
      "expect": { "http": 200, "code": 200, "json": { "data.total": "=47" } } },
    { "id": "TL06", "name": "越界pageNum=999空rows(total仍=47)", "env": "local",
      "request": { "method": "GET", "path": "/api/books", "query": { "pageNum": 999, "pageSize": 10 } },
      "expect": { "http": 200, "code": 200, "json": { "data.total": "=47" } } },
    { "id": "TL07", "name": "pageSize非数字应报分页参数非法", "env": "local",
      "request": { "method": "GET", "path": "/api/books", "query": { "pageNum": 1, "pageSize": "abc" } },
      "expect": { "http": 200, "code": 500, "msgContains": "分页参数非法" } },
    { "id": "TL08", "name": "pageSize=0应报分页参数非法", "env": "local",
      "request": { "method": "GET", "path": "/api/books", "query": { "pageNum": 1, "pageSize": 0 } },
      "expect": { "http": 200, "code": 500, "msgContains": "分页参数非法" } },
    { "id": "TL09", "name": "三段判据档20(total基准)", "env": "local",
      "request": { "method": "GET", "path": "/api/books", "query": { "pageNum": 1, "pageSize": 20 } },
      "expect": { "http": 200, "code": 200, "json": { "data.total": "=47" } } },
    { "id": "TL10", "name": "三段判据档40(total与档20相等)", "env": "local",
      "request": { "method": "GET", "path": "/api/books", "query": { "pageNum": 1, "pageSize": 40 } },
      "expect": { "http": 200, "code": 200, "json": { "data.total": "=47" } } },
    { "id": "TL11", "name": "shelf=A过滤total=20", "env": "local",
      "request": { "method": "GET", "path": "/api/books", "query": { "shelf": "A" } },
      "expect": { "http": 200, "code": 200, "json": { "data.total": "=20", "data.rows[0].shelf": "=A" } } },
    { "id": "TL12", "name": "中文keyword检索(UTF-8链路)", "env": "local",
      "request": { "method": "GET", "path": "/api/books", "query": { "keyword": "三体" } },
      "expect": { "http": 200, "code": 200, "json": { "data.total": "=1", "data.rows[0].title": "contains:三体" } } },
    { "id": "TL13", "name": "A架含不在架书(第5本available=false)", "env": "local",
      "request": { "method": "GET", "path": "/api/books", "query": { "shelf": "A", "pageNum": 1, "pageSize": 20 } },
      "expect": { "http": 200, "code": 200, "json": { "data.rows[4].bookId": "=5", "data.rows[4].available": "=false" } } },
    { "id": "TL14", "name": "写接口无token应401", "env": "local",
      "request": { "method": "POST", "path": "/api/borrows", "body": { "bookId": 7 } },
      "expect": { "http": 200, "code": 401, "msgContains": "未登录或凭证无效" } },
    { "id": "TL15", "name": "写接口伪token应401", "env": "local",
      "request": { "method": "POST", "path": "/api/borrows", "headers": { "Authorization": "Bearer fake-token-xyz" }, "body": { "bookId": 7 } },
      "expect": { "http": 200, "code": 401, "msgContains": "未登录或凭证无效" } }
  ]
}
